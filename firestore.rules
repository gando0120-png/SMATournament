rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function operatorRecord(uid) {
      return get(/databases/$(database)/documents/operators/$(uid)).data;
    }

    function isOperatorEnabled() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid))
        && operatorRecord(request.auth.uid).enabled == true;
    }

    function isTournamentOwner(tournamentId) {
      return isAuthenticated()
        && tournamentData(tournamentId).createdBy == request.auth.uid;
    }

    function canManageTournament(tournamentId) {
      return isOperatorEnabled() || isTournamentOwner(tournamentId);
    }

    function tournamentData(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
    }

    function isEntryOpenFromData(t) {
      return !isTournamentDeletedData(t)
        && t.status == 'open'
        && hasOpenEntryDeadline(t);
    }

    function isEntryOpen(tournamentId) {
      return isEntryOpenFromData(tournamentData(tournamentId));
    }

    // 大会本体 GET: 運営者/所有者は開催日・status・締切に依存しない
    function canManageTournamentRead() {
      return isOperatorEnabled()
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    function isPublicTournamentGet() {
      return isEntryOpenFromData(resource.data);
    }

    function isTournamentDeletedData(t) {
      return ('isDeleted' in t) && t.isDeleted == true;
    }

    function isTournamentDeleted(tournamentId) {
      return isTournamentDeletedData(tournamentData(tournamentId));
    }

    function finalsBracketData(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsBracket/current).data;
    }

    // 空ドキュメントや空 matches だけではロックしない（実ブラケットのみ）
    function hasMaterialBracketDoc(data) {
      return (data.bracketSize is int && data.bracketSize >= 2)
        || (data.matches is list && data.matches.size() > 0);
    }

    function hasMaterialFinalsBracket(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsBracket/current)
        && hasMaterialBracketDoc(finalsBracketData(tournamentId));
    }

    function hasMaterialConsolationBracket(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationBracket/current)
        && hasMaterialBracketDoc(consolationBracketData(tournamentId));
    }

    function hasStructureLock(tournamentId) {
      let t = tournamentData(tournamentId);
      return ('structureLocked' in t && t.structureLocked == true)
        || exists(/databases/$(database)/documents/tournaments/$(tournamentId)/blockDraw/current)
        || exists(/databases/$(database)/documents/tournaments/$(tournamentId)/qualifyingSchedules/current)
        || exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current)
        || hasMaterialFinalsBracket(tournamentId);
    }

    function hasFinalsWinsRequiredLock(tournamentId) {
      return hasMaterialFinalsBracket(tournamentId)
        || hasMaterialConsolationBracket(tournamentId);
    }

    function structureLockedUnchanged(old, newData) {
      return !('structureLocked' in old)
        ? !('structureLocked' in newData)
        : (('structureLocked' in newData) && newData.structureLocked == old.structureLocked);
    }

    function validFinalsRoundOverrides(overrides) {
      return overrides is map
        && overrides.keys().hasOnly([
          'roundOf64',
          'roundOf32',
          'roundOf16',
          'quarterfinal',
          'semifinal',
          'final'
        ])
        && (!('roundOf64' in overrides) || overrides.roundOf64 in [2, 3])
        && (!('roundOf32' in overrides) || overrides.roundOf32 in [2, 3])
        && (!('roundOf16' in overrides) || overrides.roundOf16 in [2, 3])
        && (!('quarterfinal' in overrides) || overrides.quarterfinal in [2, 3])
        && (!('semifinal' in overrides) || overrides.semifinal in [2, 3])
        && (!('final' in overrides) || overrides.final in [2, 3]);
    }

    function validFinalsMatchRules(rules) {
      return rules is map
        && rules.keys().hasOnly(['defaultWinsRequired', 'roundOverrides'])
        && rules.defaultWinsRequired in [2, 3]
        && validFinalsRoundOverrides(rules.roundOverrides);
    }

    function finalsMatchRulesUnchanged(old, newData) {
      return (!('finalsMatchRules' in old) && !('finalsMatchRules' in newData))
        || (
          ('finalsMatchRules' in old)
          && ('finalsMatchRules' in newData)
          && newData.finalsMatchRules == old.finalsMatchRules
        );
    }

    function validAggregateMatchRules(rules) {
      return rules is map
        && rules.keys().hasOnly([
          'teamCount',
          'setCount',
          'qualifiersCount',
          'rankingMethod',
          'tieBreakMethod'
        ])
        && rules.teamCount in [2, 3, 4]
        && rules.setCount == 2
        && rules.qualifiersCount in [1, 2]
        && rules.qualifiersCount < rules.teamCount
        && rules.rankingMethod == 'totalScoreDesc'
        && rules.tieBreakMethod == 'manual';
    }

    function validMatchFormat(value) {
      return value == 'headToHeadSets' || value == 'multiTeamTotal';
    }

    function hasAggregateMatchRulesLock(tournamentId) {
      return hasFinalsWinsRequiredLock(tournamentId);
    }

    // 詳細検証はクライアント側。Rules は map であることとサイド不変のみ担保（式評価上限対策）
    function validBracketMatchConfig(config) {
      return config is map;
    }

    function bracketMatchConfigSideUnchanged(old, newData, side) {
      return !('bracketMatchConfig' in old)
        || !(side in old.bracketMatchConfig)
        || (
          ('bracketMatchConfig' in newData)
          && (side in newData.bracketMatchConfig)
          && old.bracketMatchConfig[side] == newData.bracketMatchConfig[side]
        );
    }

    function isMainBracketDisabledInConfig(tournamentId) {
      let t = tournamentData(tournamentId);
      return ('bracketMatchConfig' in t)
        && ('main' in t.bracketMatchConfig)
        && t.bracketMatchConfig.main.enabled == false;
    }

    function validStructureLockedFlagUpdate() {
      let old = resource.data;
      let newData = request.resource.data;
      return (!('structureLocked' in old) || old.structureLocked != true)
        && ('structureLocked' in newData)
        && newData.structureLocked == true
        && newData.diff(old).affectedKeys().hasOnly(['structureLocked', 'updatedAt']);
    }

    function isDeletedFieldUnchanged() {
      let old = resource.data;
      let newData = request.resource.data;
      return (!('isDeleted' in old) && !('isDeleted' in newData))
        || newData.isDeleted == old.isDeleted;
    }

    function isLegacyTournamentData(t) {
      return !('tournamentFormat' in t);
    }

    function isAllowedBlockCountValue(n) {
      return n == 4 || n == 8 || n == 16 || n == 32;
    }

    function tournamentCreateCommonFields(data) {
      return data.status == 'draft'
        && data.createdBy == request.auth.uid
        && data.entryCount == 0
        && data.confirmedCount == 0
        && data.name is string
        && data.name.size() > 0
        && data.eventDate is string
        && data.venue is string
        && data.venue.size() > 0
        && data.entryDeadline is timestamp
        && data.maxTeams is int
        && data.maxTeams >= 2
        && data.teamSize is int
        && data.teamSize >= 1
        && data.teamSize <= 4
        && data.courtCount is int
        && data.courtCount >= 1
        && (!('winsRequired' in data) || data.winsRequired in [2, 3])
        && (!('finalsMatchRules' in data) || validFinalsMatchRules(data.finalsMatchRules))
        && (!('matchFormat' in data) || validMatchFormat(data.matchFormat))
        && (
          !('bracketMatchConfig' in data)
          || validBracketMatchConfig(data.bracketMatchConfig)
        )
        && (!('publicViewEnabled' in data) || data.publicViewEnabled is bool)
        && (!('participantResultEntryEnabled' in data) || data.participantResultEntryEnabled is bool);
    }

    function validLegacyTournamentCreate(data) {
      return isLegacyTournamentData(data)
        && data.preferredBlockSize is int
        && data.preferredBlockSize >= 2;
    }

    function validQualifyingFinalsTournamentCreate(data) {
      return data.tournamentFormat == 'qualifying_and_finals'
        && isAllowedBlockCountValue(data.blockCount)
        && data.qualifiersPerBlock in [1, 2]
        && data.maxTeams >= data.blockCount * 3
        && !('preferredBlockSize' in data);
    }

    function validSingleEliminationTournamentCreate(data) {
      return data.tournamentFormat == 'single_elimination'
        && !('preferredBlockSize' in data)
        && !('blockCount' in data)
        && !('qualifiersPerBlock' in data)
        && (
          !('matchFormat' in data)
          || data.matchFormat == 'headToHeadSets'
          || (
            data.matchFormat == 'multiTeamTotal'
            && 'aggregateMatchRules' in data
            && validAggregateMatchRules(data.aggregateMatchRules)
          )
        );
    }

    function blockDrawData(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/blockDraw/current).data;
    }

    function hasBlockDraw(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/blockDraw/current);
    }

    function isBlockConfigurationLocked(tournamentId) {
      return hasBlockDraw(tournamentId)
        && (
          !('status' in blockDrawData(tournamentId))
          || blockDrawData(tournamentId).status == 'finalized'
        );
    }

    function tournamentSettingsAllowedKeys(tournamentId, old) {
      let locked = hasStructureLock(tournamentId);
      let blockConfigLocked = isBlockConfigurationLocked(tournamentId);
      let winsRequiredLocked = hasFinalsWinsRequiredLock(tournamentId);
      let baseLocked = ['name', 'eventDate', 'venue', 'entryDeadline', 'courtCount', 'updatedAt'];
      let baseUnlocked = ['name', 'eventDate', 'venue', 'entryDeadline', 'courtCount', 'maxTeams', 'teamSize', 'updatedAt'];
      let keys = locked
        ? baseLocked
        : (
          isLegacyTournamentData(old)
            ? baseUnlocked.concat(['preferredBlockSize'])
            : (
              old.tournamentFormat == 'qualifying_and_finals' && !blockConfigLocked
                ? baseUnlocked.concat(['blockCount', 'qualifiersPerBlock'])
                : baseUnlocked
            )
        );
      let withWins = winsRequiredLocked ? keys : keys.concat(['winsRequired', 'finalsMatchRules']);
      let aggregateLocked = hasAggregateMatchRulesLock(tournamentId);
      let withFormat = aggregateLocked
        ? withWins
        : (
          old.tournamentFormat == 'single_elimination'
            ? withWins.concat(['matchFormat', 'aggregateMatchRules'])
            : withWins
        );
      // 上位/下位独立設定。サイド単位ロックは validTournamentSettingsUpdate で担保
      return (old.tournamentFormat == 'single_elimination'
          || old.tournamentFormat == 'qualifying_and_finals')
        ? withFormat.concat(['bracketMatchConfig'])
        : withFormat;
    }

    function tournamentFormatUnchanged(old, newData) {
      return isLegacyTournamentData(old)
        ? isLegacyTournamentData(newData)
        : (('tournamentFormat' in newData) && newData.tournamentFormat == old.tournamentFormat);
    }

    function validLegacySettingsFields(newData) {
      return newData.preferredBlockSize is int
        && newData.preferredBlockSize >= 2;
    }

    function validQualifyingSettingsFields(newData) {
      return isAllowedBlockCountValue(newData.blockCount)
        && newData.qualifiersPerBlock in [1, 2]
        && newData.maxTeams >= newData.blockCount * 3
        && !('preferredBlockSize' in newData);
    }

    function validSingleElimSettingsFields(old, newData) {
      // 一発TNは preferredBlockSize を新規追加しない。既存残留値は変更不可のまま許容。
      return !('blockCount' in newData)
        && !('qualifiersPerBlock' in newData)
        && (
          !('preferredBlockSize' in newData)
          || (
            ('preferredBlockSize' in old)
            && newData.preferredBlockSize == old.preferredBlockSize
          )
        );
    }

    function validTournamentSettingsUpdate(tournamentId) {
      let old = resource.data;
      let newData = request.resource.data;
      let allowedKeys = tournamentSettingsAllowedKeys(tournamentId, old);
      return !isTournamentDeletedData(old)
        && !isTournamentDeletedData(newData)
        && newData.status == old.status
        && newData.createdBy == old.createdBy
        && newData.entryCount == old.entryCount
        && newData.confirmedCount == old.confirmedCount
        && isDeletedFieldUnchanged()
        && structureLockedUnchanged(old, newData)
        && tournamentFormatUnchanged(old, newData)
        && newData.name is string
        && newData.name.size() > 0
        && newData.eventDate is string
        && newData.venue is string
        && newData.venue.size() > 0
        && newData.entryDeadline is timestamp
        && newData.courtCount is int
        && newData.courtCount >= 1
        && newData.maxTeams is int
        && newData.maxTeams >= 2
        && newData.teamSize is int
        && newData.teamSize >= 1
        && newData.teamSize <= 4
        && (!('winsRequired' in newData) || newData.winsRequired in [2, 3])
        && (!('finalsMatchRules' in newData) || validFinalsMatchRules(newData.finalsMatchRules))
        && (!('matchFormat' in newData) || validMatchFormat(newData.matchFormat))
        && (
          !('aggregateMatchRules' in newData)
          || validAggregateMatchRules(newData.aggregateMatchRules)
        )
        && (
          !('bracketMatchConfig' in newData)
          || validBracketMatchConfig(newData.bracketMatchConfig)
        )
        && (
          !hasFinalsWinsRequiredLock(tournamentId)
          || (
            (
              (!('winsRequired' in old) && !('winsRequired' in newData))
              || (('winsRequired' in old) && ('winsRequired' in newData) && newData.winsRequired == old.winsRequired)
            )
            && finalsMatchRulesUnchanged(old, newData)
          )
        )
        && (
          !hasMaterialFinalsBracket(tournamentId)
          || bracketMatchConfigSideUnchanged(old, newData, 'main')
        )
        && (
          !hasMaterialConsolationBracket(tournamentId)
          || bracketMatchConfigSideUnchanged(old, newData, 'consolation')
        )
        // matchFormat / aggregateMatchRules のロックは allowedKeys から除外して担保
        && newData.updatedAt == request.time
        && newData.diff(old).affectedKeys().hasOnly(allowedKeys)
        && (
          (isLegacyTournamentData(old) && validLegacySettingsFields(newData))
          || (old.tournamentFormat == 'qualifying_and_finals' && validQualifyingSettingsFields(newData))
          || (old.tournamentFormat == 'single_elimination' && validSingleElimSettingsFields(old, newData))
        );
    }

    function validTournamentSoftDeleteUpdate() {
      let old = resource.data;
      let newData = request.resource.data;
      return !isTournamentDeletedData(old)
        && newData.isDeleted == true
        && newData.deletedAt == request.time
        && newData.deletedBy == request.auth.uid
        && newData.diff(old).affectedKeys().hasOnly(['isDeleted', 'deletedAt', 'deletedBy', 'updatedAt']);
    }

    function hasOpenEntryDeadline(t) {
      return !('entryDeadline' in t)
        || t.entryDeadline == null
        || (t.entryDeadline is timestamp && request.time < t.entryDeadline);
    }

    function validEntryStatus() {
      return request.resource.data.status in ['applied', 'waitlisted'];
    }

    // Phase 3: 公開エントリー（pending）。受付期間・定員判定は Phase 4 以降
    function optionalEntryString(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is string;
    }

    function validEntryEmail() {
      return request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254;
    }

    function validPublicEntryCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'teamName',
          'representativeName',
          'email',
          'status',
          'createdAt'
        ])
        && data.teamName is string
        && data.teamName.size() > 0
        && data.representativeName is string
        && data.representativeName.size() > 0
        && validEntryEmail()
        && data.status == 'pending'
        && data.createdAt == request.time
        && !('isDummy' in data)
        && optionalEntryString('member2')
        && optionalEntryString('member3')
        && optionalEntryString('member4')
        && optionalEntryString('comment');
    }

    function isTestTournamentName(name) {
      return name is string
        && (
          name.matches('(?i)^\\s*\\[E2E\\].*')
          || name.matches('(?i)^\\s*\\[TEST\\].*')
          || name.matches('(?i)^\\s*E2E\\s*$')
          || name.matches('(?i)^\\s*E2E\\s+.*')
          || name.matches('(?i)^\\s*TEST\\s*$')
          || name.matches('(?i)^\\s*TEST\\s+.*')
        );
    }

    // ダミー entry 変更ロック。finalsMatchResults は Rules では個別に列挙しない。
    // finalsBracket/current 作成済みならロックされ、通常フローでは bracket なしで
    // finalsMatchResults 単独は存在しない前提（client 側は防御的に件数も確認）。
    function hasDummyEntryStructureLock(tournamentId) {
      return hasStructureLock(tournamentId)
        || exists(/databases/$(database)/documents/tournaments/$(tournamentId)/tournamentResults/current);
    }

    function validDummyEntryEmail() {
      return request.resource.data.email is string
        && request.resource.data.email.matches('.*@example\\.invalid$');
    }

    function validDummyEntryCreate(tournamentId) {
      let data = request.resource.data;
      return canManageTournament(tournamentId)
        && isTournamentOpenStatus(tournamentId)
        && isTestTournamentName(tournamentData(tournamentId).name)
        && !hasDummyEntryStructureLock(tournamentId)
        && data.keys().hasAll([
          'teamName',
          'representativeName',
          'email',
          'status',
          'createdAt',
          'updatedAt',
          'isDummy',
          'dummyBatchId',
          'dummyIndex'
        ])
        && data.teamName is string
        && data.teamName.size() > 0
        && data.representativeName is string
        && data.representativeName.size() > 0
        && validDummyEntryEmail()
        && data.status == 'confirmed'
        && data.isDummy == true
        && data.dummyBatchId is string
        && data.dummyBatchId.size() > 0
        && data.dummyIndex is int
        && data.dummyIndex >= 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && optionalEntryString('member2')
        && optionalEntryString('member3')
        && optionalEntryString('member4')
        && optionalEntryString('comment');
    }

    function validDummyEntryDelete(tournamentId) {
      return canManageTournament(tournamentId)
        && !isTournamentDeleted(tournamentId)
        && isTournamentOpenStatus(tournamentId)
        && isTestTournamentName(tournamentData(tournamentId).name)
        && !hasDummyEntryStructureLock(tournamentId)
        && ('isDummy' in resource.data && resource.data.isDummy == true);
    }

    function validTournamentCreate() {
      let data = request.resource.data;
      return tournamentCreateCommonFields(data)
        && (
          validLegacyTournamentCreate(data)
          || validQualifyingFinalsTournamentCreate(data)
          || validSingleEliminationTournamentCreate(data)
        );
    }

    function validTournamentOpenUpdate() {
      let old = resource.data;
      let newData = request.resource.data;
      return old.status == 'draft'
        && newData.status == 'open'
        && newData.diff(old).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function validTournamentCloseUpdate() {
      let old = resource.data;
      let newData = request.resource.data;
      return old.status == 'open'
        && newData.status == 'closed'
        && newData.closedAt == request.time
        && newData.updatedAt == request.time
        && newData.diff(old).affectedKeys().hasOnly(['status', 'closedAt', 'updatedAt']);
    }

    function validTournamentPublicViewUpdate() {
      let old = resource.data;
      let newData = request.resource.data;
      return newData.diff(old).affectedKeys().hasOnly(['publicViewEnabled', 'updatedAt'])
        && newData.publicViewEnabled is bool;
    }

    function isTournamentOpenStatus(tournamentId) {
      return tournamentData(tournamentId).status == 'open';
    }

    function isPublicViewEnabled(tournamentId) {
      return tournamentData(tournamentId).publicViewEnabled == true;
    }

    function hasFinalsAdvancement(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current);
    }

    function hasTournamentResults(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/tournamentResults/current);
    }

    function hasConsolationBracket(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationBracket/current);
    }

    function isQualifyingAndFinalsFormat(tournamentId) {
      let t = tournamentData(tournamentId);
      return ('tournamentFormat' in t) && t.tournamentFormat == 'qualifying_and_finals';
    }

    function consolationBracketData(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationBracket/current).data;
    }

    function isConsolationBracketMatchId(tournamentId, matchId) {
      let data = consolationBracketData(tournamentId);
      return data.matchIds is map && matchId in data.matchIds;
    }

    // create 用: 同一 writeBatch 内で作成される consolationBracket を参照する
    function hasConsolationBracketAfter(tournamentId) {
      return existsAfter(
        /databases/$(database)/documents/tournaments/$(tournamentId)/consolationBracket/current
      );
    }

    function consolationBracketDataAfter(tournamentId) {
      return getAfter(
        /databases/$(database)/documents/tournaments/$(tournamentId)/consolationBracket/current
      ).data;
    }

    function isConsolationBracketMatchIdAfter(tournamentId, matchId) {
      let data = consolationBracketDataAfter(tournamentId);
      return data.matchIds is map && matchId in data.matchIds;
    }

    function validConsolationBracketCommon(tournamentId) {
      let data = request.resource.data;
      return isQualifyingAndFinalsFormat(tournamentId)
        && !hasTournamentResults(tournamentId)
        && !hasConsolationBracket(tournamentId)
        && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current)
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current).data.finalized == true
        && (
          // 上位無効大会は上位ブラケットなしでも下位作成可
          isMainBracketDisabledInConfig(tournamentId)
          || (
            exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsBracket/current)
            && get(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsBracket/current).data.finalized == true
          )
        )
        && data.finalized == true
        && data.mode == 'consolation'
        && data.bracketKind == 'consolation'
        && data.placementMode == 'random'
        && data.teamCount is int
        && data.teamCount >= 2
        && data.teamCount <= 64
        && data.roundCount is int
        && data.roundCount >= 1
        && data.slots is list
        && data.matches is list
        && data.matches.size() >= 1
        && data.matchIds is map
        && data.matchIds.size() >= 1
        && data.matchIdsList is list
        && data.matchIdsList.size() >= 1
        && !('email' in data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validHeadToHeadConsolationBracketCreate(tournamentId) {
      let data = request.resource.data;
      return validConsolationBracketCommon(tournamentId)
        && (!('matchFormat' in data) || data.matchFormat == 'headToHeadSets')
        && data.teamCount <= data.bracketSize
        && data.bracketSize is int
        && isValidSingleElimBracketSize(data.bracketSize)
        && data.byeCount is int
        && data.byeCount == data.bracketSize - data.teamCount
        && data.qualifierCount is int
        && data.qualifierCount == data.teamCount
        && data.slots.size() == data.bracketSize;
    }

    function validMultiTeamConsolationBracketCreate(tournamentId) {
      let data = request.resource.data;
      return validConsolationBracketCommon(tournamentId)
        && data.matchFormat == 'multiTeamTotal'
        && 'aggregateMatchRules' in data
        && validAggregateMatchRules(data.aggregateMatchRules)
        && data.bracketSize is int
        && data.bracketSize == data.teamCount
        && data.slots.size() == data.teamCount
        && data.byeCount is int
        && data.byeCount == 0
        && data.qualifierCount is int
        && data.qualifierCount == data.teamCount;
    }

    function validConsolationBracketCreate(tournamentId) {
      let data = request.resource.data;
      return ('matchFormat' in data && data.matchFormat == 'multiTeamTotal')
        ? validMultiTeamConsolationBracketCreate(tournamentId)
        : validHeadToHeadConsolationBracketCreate(tournamentId);
    }

    function validConsolationMatchResultCreate(matchId) {
      let data = request.resource.data;
      return validFinalsMatchResultFields(matchId)
        && data.bracketKind == 'consolation'
        && data.createdAt == request.time;
    }

    function validConsolationMatchResultUpdate(matchId) {
      let data = request.resource.data;
      return validFinalsMatchResultFields(matchId)
        && data.bracketKind == 'consolation'
        && data.createdAt == resource.data.createdAt;
    }

    function validEntryConfirmUpdate() {
      let old = resource.data;
      let newData = request.resource.data;
      return old.status == 'pending'
        && newData.status == 'confirmed'
        && newData.diff(old).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function validLegacyBlockDrawWrite(data) {
      return data.preferredBlockSize is int
        && data.preferredBlockSize >= 2;
    }

    function validNewBlockDrawDistribution(data) {
      return data.distribution is map
        && data.distribution.minBlockSize is int
        && data.distribution.minBlockSize >= 3
        && data.distribution.maxBlockSize is int
        && data.distribution.maxBlockSize <= 8
        && data.distribution.largerBlockIds is list;
    }

    function validNewBlockDrawAutoDistribution(data) {
      return validNewBlockDrawDistribution(data)
        && data.distribution.baseSize is int
        && data.distribution.largerBlockCount is int;
    }

    function validNewBlockDrawWrite(tournamentId, data) {
      let t = tournamentData(tournamentId);
      return t.tournamentFormat == 'qualifying_and_finals'
        && data.blockCount == t.blockCount
        && !('preferredBlockSize' in data)
        && validNewBlockDrawDistribution(data);
    }

    function validLegacyBlockDrawCreate(data) {
      return !('status' in data)
        && !('finalizedAt' in data)
        && data.blockCount is int
        && data.blockCount >= 1
        && data.blocks is list
        && data.blocks.size() == data.blockCount
        && data.updatedAt == request.time
        && validLegacyBlockDrawWrite(data);
    }

    function validNewBlockDrawDraftCreate(tournamentId) {
      let data = request.resource.data;
      return data.status == 'draft'
        && data.blockCount is int
        && data.blockCount >= 1
        && data.blocks is list
        && data.blocks.size() == data.blockCount
        && !('finalizedAt' in data)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && validNewBlockDrawWrite(tournamentId, data)
        && validNewBlockDrawAutoDistribution(data);
    }

    function validBlockDrawCreate(tournamentId) {
      let t = tournamentData(tournamentId);
      return isTournamentOpenStatus(tournamentId) && (
        (isLegacyTournamentData(t) && validLegacyBlockDrawCreate(request.resource.data))
        || (t.tournamentFormat == 'qualifying_and_finals' && validNewBlockDrawDraftCreate(tournamentId))
      );
    }

    function validBlockDrawDraftUpdate(tournamentId) {
      let old = resource.data;
      let newData = request.resource.data;
      let t = tournamentData(tournamentId);
      return t.tournamentFormat == 'qualifying_and_finals'
        && old.status == 'draft'
        && newData.status == 'draft'
        && newData.blockCount == old.blockCount
        && newData.blockCount == t.blockCount
        && newData.blocks is list
        && newData.blocks.size() == newData.blockCount
        && newData.updatedAt == request.time
        && validNewBlockDrawWrite(tournamentId, newData)
        && newData.diff(old).affectedKeys().hasOnly(['blocks', 'distribution', 'updatedAt']);
    }

    function validBlockDrawFinalizeUpdate(tournamentId) {
      let old = resource.data;
      let newData = request.resource.data;
      let t = tournamentData(tournamentId);
      return t.tournamentFormat == 'qualifying_and_finals'
        && old.status == 'draft'
        && newData.status == 'finalized'
        && newData.blockCount == old.blockCount
        && newData.blockCount == t.blockCount
        && newData.blocks is list
        && newData.blocks.size() == newData.blockCount
        && newData.finalizedAt == request.time
        && newData.updatedAt == request.time
        && validNewBlockDrawWrite(tournamentId, newData)
        && newData.diff(old).affectedKeys().hasOnly(['status', 'blocks', 'distribution', 'finalizedAt', 'updatedAt']);
    }

    function validBlockDrawUpdate(tournamentId) {
      return isTournamentOpenStatus(tournamentId)
        && (
          validBlockDrawDraftUpdate(tournamentId)
          || validBlockDrawFinalizeUpdate(tournamentId)
        );
    }

    function validBlockDrawDraftDelete() {
      return resource.data.status == 'draft';
    }

    function validQualifyingScheduleCreate() {
      let data = request.resource.data;
      return data.finalized == true
        && data.blockCount is int
        && data.blockCount >= 1
        && data.totalMatchCount is int
        && data.totalMatchCount >= 1
        && data.blocks is list
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validQualifyingMatchTeam(team) {
      return team is map
        && team.keys().hasAll(['entryId', 'teamName'])
        && team.entryId is string
        && team.teamName is string;
    }

    function validSetResultScores(team1Score, team2Score, result) {
      return (result == 'team1' && team1Score > team2Score)
        || (result == 'team2' && team1Score < team2Score)
        || (result == 'draw'
          && team1Score == team2Score
          && team1Score < 50
          && team2Score < 50);
    }

    function validQualifyingSet(set) {
      return set is map
        && set.keys().hasAll(['setNumber', 'team1Score', 'team2Score', 'result'])
        && set.setNumber is int
        && set.team1Score is int
        && set.team1Score >= 0
        && set.team2Score is int
        && set.team2Score >= 0
        && set.result in ['team1', 'team2', 'draw']
        && validSetResultScores(set.team1Score, set.team2Score, set.result);
    }

    function validQualifyingTeamStats(stats) {
      return stats is map
        && stats.keys().hasAll(['setWins', 'setDraws', 'setLosses', 'totalScore'])
        && stats.setWins is int
        && stats.setWins >= 0
        && stats.setDraws is int
        && stats.setDraws >= 0
        && stats.setLosses is int
        && stats.setLosses >= 0
        && stats.totalScore is int
        && stats.totalScore >= 0
        && stats.setWins + stats.setDraws + stats.setLosses == 2;
    }

    function validTeam1StatsMatch(sets, stats) {
      let wins = (sets[0].result == 'team1' ? 1 : 0) + (sets[1].result == 'team1' ? 1 : 0);
      let draws = (sets[0].result == 'draw' ? 1 : 0) + (sets[1].result == 'draw' ? 1 : 0);
      let losses = (sets[0].result == 'team2' ? 1 : 0) + (sets[1].result == 'team2' ? 1 : 0);
      let total = sets[0].team1Score + sets[1].team1Score;
      return stats.setWins == wins
        && stats.setDraws == draws
        && stats.setLosses == losses
        && stats.totalScore == total;
    }

    function validTeam2StatsMatch(sets, stats) {
      let wins = (sets[0].result == 'team2' ? 1 : 0) + (sets[1].result == 'team2' ? 1 : 0);
      let draws = (sets[0].result == 'draw' ? 1 : 0) + (sets[1].result == 'draw' ? 1 : 0);
      let losses = (sets[0].result == 'team1' ? 1 : 0) + (sets[1].result == 'team1' ? 1 : 0);
      let total = sets[0].team2Score + sets[1].team2Score;
      return stats.setWins == wins
        && stats.setDraws == draws
        && stats.setLosses == losses
        && stats.totalScore == total;
    }

    function validQualifyingMatchResultFields(matchId) {
      let data = request.resource.data;
      let sets = data.sets;
      return data.matchId == matchId
        && data.status == 'finished'
        && data.blockId is string
        && data.roundNumber is int
        && data.courtNumber is int
        && validQualifyingMatchTeam(data.team1)
        && validQualifyingMatchTeam(data.team2)
        && sets is list
        && sets.size() == 2
        && validQualifyingSet(sets[0])
        && validQualifyingSet(sets[1])
        && sets[0].setNumber == 1
        && sets[1].setNumber == 2
        && validQualifyingTeamStats(data.team1Stats)
        && validQualifyingTeamStats(data.team2Stats)
        && validTeam1StatsMatch(sets, data.team1Stats)
        && validTeam2StatsMatch(sets, data.team2Stats)
        && data.updatedAt == request.time;
    }

    function validQualifyingMatchResultCreate(matchId) {
      return validQualifyingMatchResultFields(matchId)
        && request.resource.data.createdAt == request.time;
    }

    function validQualifyingMatchResultUpdate(matchId) {
      return validQualifyingMatchResultFields(matchId)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validQualifyingMatchSessionCreate(matchId) {
      let data = request.resource.data;
      return data.matchId == matchId
        && data.status == 'playing'
        && data.startedAt == request.time
        && data.updatedAt == request.time;
    }

    function validQualifyingMatchSessionUpdate(matchId) {
      let data = request.resource.data;
      let old = resource.data;
      return data.matchId == matchId
        && data.status == 'playing'
        && data.updatedAt == request.time
        && data.startedAt == old.startedAt;
    }

    function validQualifyingMatchSessionFinishUpdate(matchId) {
      let data = request.resource.data;
      let old = resource.data;
      return data.matchId == matchId
        && old.status == 'playing'
        && data.status == 'finished'
        && data.startedAt == old.startedAt
        && data.finishedAt == request.time
        && data.updatedAt == request.time;
    }

    function validLegacyFinalsAdvancementCreate() {
      let data = request.resource.data;
      return data.finalized == true
        && data.finalTeamCount is int
        && data.finalTeamCount >= 2
        && data.blockCount is int
        && data.blockCount >= 1
        && data.blockWinnerCount is int
        && data.blockWinnerCount >= 0
        && data.wildcardCount is int
        && data.wildcardCount >= 0
        && data.qualifiers is list
        && data.qualifiers.size() == data.finalTeamCount
        && data.qualifyingMatchCount is int
        && data.qualifyingMatchCount >= 1
        && data.qualifyingFinishedMatchCount is int
        && data.qualifyingFinishedMatchCount == data.qualifyingMatchCount
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validNewFinalsAdvancementCreate(tournamentId) {
      let data = request.resource.data;
      let t = tournamentData(tournamentId);
      let expectedCount = t.blockCount * t.qualifiersPerBlock;
      return t.tournamentFormat == 'qualifying_and_finals'
        && data.finalized == true
        && data.mode == 'fixed_block_qualifiers'
        && data.blockCount == t.blockCount
        && data.qualifiersPerBlock == t.qualifiersPerBlock
        && data.qualifierCount == expectedCount
        && data.qualifierCount == t.blockCount * t.qualifiersPerBlock
        && data.qualifiers is list
        && data.qualifiers.size() == data.qualifierCount
        && data.qualifyingMatchCount is int
        && data.qualifyingMatchCount >= 1
        && data.qualifyingFinishedMatchCount is int
        && data.qualifyingFinishedMatchCount == data.qualifyingMatchCount
        && data.finalizedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validFinalsAdvancementCreate(tournamentId) {
      return isLegacyTournamentData(tournamentData(tournamentId))
        ? validLegacyFinalsAdvancementCreate()
        : validNewFinalsAdvancementCreate(tournamentId);
    }

    function isValidSingleElimBracketSize(size) {
      return size == 2
        || size == 4
        || size == 8
        || size == 16
        || size == 32
        || size == 64;
    }

    function validQualifyingFinalsBracketCreateH2H(tournamentId) {
      let data = request.resource.data;
      return data.finalized == true
        && (!('mode' in data) || data.mode != 'single_elimination')
        && (!('matchFormat' in data) || data.matchFormat == 'headToHeadSets')
        && data.bracketSize is int
        && data.bracketSize >= 4
        && data.qualifierCount is int
        && data.qualifierCount >= 1
        && data.qualifierCount <= data.bracketSize
        && data.roundCount is int
        && data.roundCount >= 2
        && data.slots is list
        && data.slots.size() == data.bracketSize
        && data.matches is list
        && data.matches.size() >= 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current);
    }

    function validQualifyingFinalsBracketCreateMulti(tournamentId) {
      let data = request.resource.data;
      return data.finalized == true
        && (!('mode' in data) || data.mode != 'single_elimination')
        && data.matchFormat == 'multiTeamTotal'
        && 'aggregateMatchRules' in data
        && validAggregateMatchRules(data.aggregateMatchRules)
        && data.bracketSize is int
        && data.teamCount is int
        && data.bracketSize == data.teamCount
        && data.teamCount >= 2
        && data.teamCount <= 64
        && data.qualifierCount is int
        && data.qualifierCount >= 1
        && data.qualifierCount <= data.bracketSize
        && data.roundCount is int
        && data.roundCount >= 1
        && data.slots is list
        && data.slots.size() == data.teamCount
        && data.matches is list
        && data.matches.size() >= 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current);
    }

    function validQualifyingFinalsBracketCreate(tournamentId) {
      let data = request.resource.data;
      return ('matchFormat' in data && data.matchFormat == 'multiTeamTotal')
        ? validQualifyingFinalsBracketCreateMulti(tournamentId)
        : validQualifyingFinalsBracketCreateH2H(tournamentId);
    }

    function validSingleElimFinalsBracketCreate(tournamentId) {
      let data = request.resource.data;
      let t = tournamentData(tournamentId);
      return t.tournamentFormat == 'single_elimination'
        && data.finalized == true
        && data.mode == 'single_elimination'
        && data.bracketSize is int
        && isValidSingleElimBracketSize(data.bracketSize)
        && data.teamCount is int
        && data.teamCount >= 2
        && data.teamCount <= 64
        && data.teamCount <= data.bracketSize
        && data.byeCount is int
        && data.byeCount == data.bracketSize - data.teamCount
        && data.qualifierCount is int
        && data.qualifierCount == data.teamCount
        && data.roundCount is int
        && data.roundCount >= 1
        && data.slots is list
        && data.slots.size() == data.bracketSize
        && data.matches is list
        && data.matches.size() >= 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validMultiTeamFinalsBracketCreate(tournamentId) {
      let data = request.resource.data;
      let t = tournamentData(tournamentId);
      return t.tournamentFormat == 'single_elimination'
        && data.matchFormat == 'multiTeamTotal'
        && data.finalized == true
        && data.mode == 'single_elimination'
        && data.teamCount is int
        && data.teamCount >= 2
        && data.teamCount <= 64
        && data.bracketSize is int
        && data.bracketSize == data.teamCount
        && data.roundCount is int
        && data.roundCount >= 1
        && data.slots is list
        && data.slots.size() == data.teamCount
        && data.matches is list
        && data.matches.size() >= 1
        && 'aggregateMatchRules' in data
        && validAggregateMatchRules(data.aggregateMatchRules)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validFinalsBracketCreate(tournamentId) {
      let t = tournamentData(tournamentId);
      let data = request.resource.data;
      return t.tournamentFormat == 'single_elimination'
        ? (
          ('matchFormat' in data && data.matchFormat == 'multiTeamTotal')
            ? validMultiTeamFinalsBracketCreate(tournamentId)
            : validSingleElimFinalsBracketCreate(tournamentId)
        )
        : validQualifyingFinalsBracketCreate(tournamentId);
    }

    function validQualifyingFinalsBracketUpdate(tournamentId) {
      let data = request.resource.data;
      return data.finalized == true
        && (!('mode' in data) || data.mode != 'single_elimination')
        && data.bracketSize is int
        && data.bracketSize >= 4
        && data.qualifierCount is int
        && data.qualifierCount >= 1
        && data.qualifierCount <= data.bracketSize
        && data.roundCount is int
        && data.roundCount >= 2
        && data.slots is list
        && data.slots.size() == data.bracketSize
        && data.matches is list
        && data.matches.size() >= 1
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time
        && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/current);
    }

    function validFinalsBracketUpdate(tournamentId) {
      let t = tournamentData(tournamentId);
      // 一発TNは再生成対象外。予選+決勝のみ update を許可する。
      return t.tournamentFormat != 'single_elimination'
        && validQualifyingFinalsBracketUpdate(tournamentId);
    }

    function validFinalsMatchTeam(team) {
      return team is map
        && team.entryId is string
        && team.teamName is string
        && team.seed is int;
    }

    function validFinalsSet(set) {
      return set is map
        && set.setNumber is int
        && set.setNumber >= 1
        && set.setNumber <= 5
        && set.team1Score is int
        && set.team1Score >= 0
        && set.team1Score <= 50
        && set.team2Score is int
        && set.team2Score >= 0
        && set.team2Score <= 50
        && set.winner in ['team1', 'team2'];
    }

    function validFinalsPlayedResult(matchId) {
      let data = request.resource.data;
      let sets = data.sets;
      let hasWinsRequired = 'winsRequired' in data;
      let winsRequired = hasWinsRequired && data.winsRequired in [2, 3] ? data.winsRequired : 2;
      let maxSets = hasWinsRequired ? winsRequired * 2 - 1 : 5;
      return data.matchId == matchId
        && data.status == 'finished'
        && data.resolution == 'played'
        && data.roundNumber is int
        && data.matchNumber is int
        && validFinalsMatchTeam(data.team1)
        && validFinalsMatchTeam(data.team2)
        && validFinalsMatchTeam(data.winner)
        && validFinalsMatchTeam(data.loser)
        && data.winnerSide in ['team1', 'team2']
        && sets is list
        && sets.size() >= 2
        && sets.size() <= maxSets
        && (!hasWinsRequired || data.winsRequired in [2, 3])
        && data.team1SetWins is int
        && data.team2SetWins is int
        && data.updatedAt == request.time;
    }

    function validFinalsByeResult(matchId) {
      let data = request.resource.data;
      return data.matchId == matchId
        && data.status == 'finished'
        && data.resolution == 'bye'
        && data.roundNumber is int
        && data.matchNumber is int
        && validFinalsMatchTeam(data.winner)
        && data.loser == null
        && data.sets is list
        && data.sets.size() == 0
        && data.updatedAt == request.time;
    }

    function validMultiTeamPlayedResult(matchId) {
      let data = request.resource.data;
      // 最終ラウンドは qualifierEntryIds を省略可。中間は件数一致を要求。
      let qualifiersOk = !('qualifierEntryIds' in data)
        || (
          data.qualifierEntryIds is list
          && data.qualifierEntryIds.size() == data.qualifiersCount
        );
      return data.matchId == matchId
        && data.matchFormat == 'multiTeamTotal'
        && data.status == 'finished'
        && data.resolution in ['played', 'auto_advance']
        && data.roundNumber is int
        && data.matchNumber is int
        && data.setCount == 2
        && data.qualifiersCount in [1, 2]
        && data.participantEntryIds is list
        && data.participantEntryIds.size() >= 2
        && data.scores is map
        && data.scores.size() == data.participantEntryIds.size()
        && data.totals is map
        && data.totals.size() == data.participantEntryIds.size()
        && data.rankingEntryIds is list
        && data.rankingEntryIds.size() == data.participantEntryIds.size()
        && qualifiersOk
        && data.updatedAt == request.time;
    }

    function validFinalsMatchResultFields(matchId) {
      let data = request.resource.data;
      return (
          ('matchFormat' in data && data.matchFormat == 'multiTeamTotal')
            ? validMultiTeamPlayedResult(matchId)
            : (
              (data.resolution == 'played' && validFinalsPlayedResult(matchId))
              || (data.resolution == 'bye' && validFinalsByeResult(matchId))
            )
        );
    }

    function validFinalsMatchResultCreate(matchId) {
      return validFinalsMatchResultFields(matchId)
        && request.resource.data.createdAt == request.time;
    }

    function validFinalsMatchResultUpdate(matchId) {
      return validFinalsMatchResultFields(matchId)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validFinalsMatchSessionCreate(matchId) {
      let data = request.resource.data;
      return data.matchId == matchId
        && data.status == 'playing'
        && data.roundNumber is int
        && data.matchNumber is int
        && validFinalsMatchTeam(data.team1)
        && validFinalsMatchTeam(data.team2)
        && data.startedAt == request.time
        && data.updatedAt == request.time;
    }

    function validFinalsMatchSessionUpdate(matchId) {
      let data = request.resource.data;
      let old = resource.data;
      return data.matchId == matchId
        && data.status == 'playing'
        && data.roundNumber == old.roundNumber
        && data.matchNumber == old.matchNumber
        && data.team1 == old.team1
        && data.team2 == old.team2
        && data.startedAt == old.startedAt
        && data.updatedAt == request.time;
    }

    function validFinalsMatchSessionFinishUpdate(matchId) {
      let data = request.resource.data;
      let old = resource.data;
      return data.matchId == matchId
        && old.status == 'playing'
        && data.status == 'finished'
        && data.roundNumber == old.roundNumber
        && data.matchNumber == old.matchNumber
        && data.team1 == old.team1
        && data.team2 == old.team2
        && data.startedAt == old.startedAt
        && data.finishedAt == request.time
        && data.updatedAt == request.time;
    }

    function validTournamentResultsCreate(tournamentId) {
      let data = request.resource.data;
      return data.finalized == true
        && data.tournamentId == tournamentId
        && data.tournamentStatus == 'closed'
        && data.tournamentName is string
        && data.champion is map
        && data.runnerUp is map
        && data.placements is list
        && data.qualifierCount is int
        && data.bracketSize is int
        && data.completedMatchCount is int
        && data.expectedMatchCount is int
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // MVP: receiptNumber は未使用（null または省略）。自動ドキュメント ID で保存
    function validNewEntryFields() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'teamName',
          'representativeName',
          'representativeContact',
          'members',
          'note',
          'status',
          'appliedAt',
          'updatedAt',
          'source'
        ])
        && data.teamName is string
        && data.teamName.size() > 0
        && data.representativeName is string
        && data.representativeName.size() > 0
        && data.representativeContact is string
        && data.members is list
        && data.source == 'public'
        && (!('receiptNumber' in data) || data.receiptNumber == null);
    }

    // ── 運営者登録 ────────────────────────────────────
    // MVP: Console から手動登録のみ。クライアントからの write 不可
    match /operators/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // ── 大会 ──────────────────────────────────────────
    match /tournaments/{tournamentId} {

      allow list: if isOperatorEnabled()
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      allow get: if canManageTournamentRead()
        || isPublicTournamentGet();

      allow create: if isOperatorEnabled() && validTournamentCreate();
      allow update: if canManageTournament(tournamentId)
        && (validTournamentOpenUpdate()
          || validTournamentCloseUpdate()
          || validTournamentPublicViewUpdate()
          || validTournamentSettingsUpdate(tournamentId)
          || validTournamentSoftDeleteUpdate()
          || validStructureLockedFlagUpdate());
      allow delete: if false;

      match /entries/{entryId} {
        // 一般参加者: 受付中のみ新規作成可。一覧・取得・更新・削除は不可
        allow get, list: if canManageTournament(tournamentId);

        allow create: if !isTournamentDeleted(tournamentId)
          && (
            (validPublicEntryCreate() && isEntryOpen(tournamentId))
            || validDummyEntryCreate(tournamentId)
          );

        allow update: if canManageTournament(tournamentId)
          && !isTournamentDeleted(tournamentId)
          && validEntryConfirmUpdate()
          && isTournamentOpenStatus(tournamentId);
        allow delete: if validDummyEntryDelete(tournamentId);
      }

      // counters/receipt — 将来 Cloud Functions で連番採番時に追加（MVP では未使用）

      match /blockDraw/{drawId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && drawId == 'current'
          && validBlockDrawCreate(tournamentId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/blockDraw/$(drawId));
        allow update: if canManageTournament(tournamentId)
          && drawId == 'current'
          && validBlockDrawUpdate(tournamentId);
        allow delete: if canManageTournament(tournamentId)
          && drawId == 'current'
          && isTournamentOpenStatus(tournamentId)
          && validBlockDrawDraftDelete();
      }

      match /qualifyingSchedules/{scheduleId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && validQualifyingScheduleCreate()
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/qualifyingSchedules/$(scheduleId));
        allow update, delete: if false;
      }

      match /qualifyingMatchResults/{matchId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && !hasFinalsAdvancement(tournamentId)
          && validQualifyingMatchResultCreate(matchId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/qualifyingMatchResults/$(matchId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && !hasFinalsAdvancement(tournamentId)
          && validQualifyingMatchResultUpdate(matchId)
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/qualifyingMatchResults/$(matchId));
        allow delete: if false;
      }

      match /qualifyingMatchSessions/{matchId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && validQualifyingMatchSessionCreate(matchId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/qualifyingMatchSessions/$(matchId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/qualifyingMatchSessions/$(matchId))
          && (validQualifyingMatchSessionUpdate(matchId) || validQualifyingMatchSessionFinishUpdate(matchId));
        allow delete: if false;
      }

      match /finalsAdvancement/{advancementId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && validFinalsAdvancementCreate(tournamentId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsAdvancement/$(advancementId));
        allow update, delete: if false;
      }

      match /molkkyOutResolutions/{resolutionId} {
        allow read: if canManageTournament(tournamentId);
        allow create, update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && resolutionId == 'current'
          && !hasFinalsAdvancement(tournamentId)
          && request.resource.data.keys().hasOnly(['blockGroups', 'wildcardGroups', 'updatedAt'])
          && request.resource.data.blockGroups is list
          && request.resource.data.wildcardGroups is list;
        allow delete: if false;
      }

      match /finalsBracket/{bracketId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && bracketId == 'current'
          && validFinalsBracketCreate(tournamentId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsBracket/$(bracketId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && bracketId == 'current'
          && validFinalsBracketUpdate(tournamentId)
          && !hasConsolationBracket(tournamentId);
        allow delete: if false;
      }

      match /finalsMatchSessions/{matchId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && validFinalsMatchSessionCreate(matchId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsMatchSessions/$(matchId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsMatchSessions/$(matchId))
          && (validFinalsMatchSessionUpdate(matchId) || validFinalsMatchSessionFinishUpdate(matchId));
        allow delete: if false;
      }

      match /finalsMatchResults/{matchId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && validFinalsMatchResultCreate(matchId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsMatchResults/$(matchId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && validFinalsMatchResultUpdate(matchId)
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/finalsMatchResults/$(matchId));
        // 再生成時の BYE 自動結果掃除のみ許可（played は削除不可）
        allow delete: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && resource.data.resolution == 'bye';
      }

      match /consolationBracket/{bracketId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && bracketId == 'current'
          && validConsolationBracketCreate(tournamentId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationBracket/$(bracketId));
        allow update, delete: if false;
      }

      match /consolationMatchSessions/{matchId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && !hasTournamentResults(tournamentId)
          && hasConsolationBracketAfter(tournamentId)
          && isConsolationBracketMatchIdAfter(tournamentId, matchId)
          && validFinalsMatchSessionCreate(matchId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationMatchSessions/$(matchId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && !hasTournamentResults(tournamentId)
          && hasConsolationBracket(tournamentId)
          && isConsolationBracketMatchId(tournamentId, matchId)
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationMatchSessions/$(matchId))
          && (validFinalsMatchSessionUpdate(matchId) || validFinalsMatchSessionFinishUpdate(matchId));
        allow delete: if false;
      }

      match /consolationMatchResults/{matchId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && !hasTournamentResults(tournamentId)
          && hasConsolationBracketAfter(tournamentId)
          && isConsolationBracketMatchIdAfter(tournamentId, matchId)
          && validConsolationMatchResultCreate(matchId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationMatchResults/$(matchId));
        allow update: if canManageTournament(tournamentId)
          && isTournamentOpenStatus(tournamentId)
          && !hasTournamentResults(tournamentId)
          && hasConsolationBracket(tournamentId)
          && isConsolationBracketMatchId(tournamentId, matchId)
          && validConsolationMatchResultUpdate(matchId)
          && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/consolationMatchResults/$(matchId));
        allow delete: if false;
      }

      match /tournamentResults/{resultsId} {
        allow read: if canManageTournament(tournamentId);
        allow create: if canManageTournament(tournamentId)
          && resultsId == 'current'
          && isTournamentOpenStatus(tournamentId)
          && validTournamentResultsCreate(tournamentId)
          && !exists(/databases/$(database)/documents/tournaments/$(tournamentId)/tournamentResults/$(resultsId));
        allow update, delete: if false;
      }

      match /publicSnapshot/{snapshotId} {
        allow read: if snapshotId == 'current' && isPublicViewEnabled(tournamentId);
        allow create, update: if canManageTournament(tournamentId);
        allow delete: if false;
      }
    }
  }
}
