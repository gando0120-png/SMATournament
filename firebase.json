{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions run sync-domain"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8090
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/node_modules/**",
      "docs/**",
      "tests/**",
      "scripts/**",
      "tools/**",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "firestore-debug.log",
      "*.md",
      "tmp/**",
      "**/*.log",
      "**/*.xlsx",
      "**/*.xls",
      "_section.txt",
      "serve.json",
      "_legacy/**",
      "functions/**",
      "**/.env",
      "**/.env.*",
      "**/*service-account*.json",
      "**/*serviceAccount*.json",
      "**/*credentials*.json",
      "**/firebase-adminsdk*.json",
      "**/*-firebase-adminsdk-*.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  }
}
